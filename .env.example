# Copy to .env and fill in. Never commit .env.

# --- Mode ---
# local  = no Huawei Cloud calls at all: local Mosquitto, Docker Redis/MySQL, Ollama chat, console alerts
# huawei = IoTDA (MQTT + HTTP push), DCS Redis, RDS MySQL, SMN alerts, MaaS chat, from the values below
NADI_MODE=local

# --- Local MQTT broker (NADI_MODE=local, docker compose service "mosquitto") ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# The broker always listens on 127.0.0.1. Put this laptop's Wi-Fi IPv4 address here (ipconfig) so the ESP32
# boards on the same network can reach it too; empty = laptop only. Then: docker compose up -d mosquitto
MQTT_LAN_IP=
# Device id the simulator uses in the topic $oc/devices/{id}/sys/properties/report
SIM_DEVICE_ID=nadi-sim
# Devices allowed to log in to the broker (username = device ID), comma separated. Each board's device ID goes here.
MQTT_DEVICE_IDS=nadi-sim,nadi-recv-1,nadi-climate-1
# Broker passwords. Leave empty: python scripts/mqtt_users.py fills them in and writes deploy/mosquitto/passwd.
# The server logs in as nadi-server. Each device has its own password, MQTT_PASSWORD_<DEVICE ID> with - as _
# (type it into that board's firmware settings). The script adds a line for every ID in MQTT_DEVICE_IDS.
MQTT_SERVER_PASSWORD=
MQTT_PASSWORD_NADI_SIM=
MQTT_PASSWORD_NADI_RECV_1=
MQTT_PASSWORD_NADI_CLIMATE_1=
# Which rooms each device may report for: device:room, comma separated, * = any room (the simulator sends all rooms).
# When set, a device that is not listed is refused. Empty = any device may report any known room (warned at start-up).
DEVICE_ROOMS=nadi-sim:*,nadi-recv-1:room1,nadi-climate-1:room1

# --- Board provisioning (python scripts/provision.py --role send|recv|climate) ---
# The 2.4 GHz Wi-Fi network (for example a phone hotspot) the boards join. The script types these into the board
# over USB with "setup"; the password is never printed. The broker address is MQTT_LAN_IP and each board's MQTT
# password is its MQTT_PASSWORD_<DEVICE ID> above.
NADI_WIFI_SSID=
NADI_WIFI_PASS=

# --- Dashboard names (display only; room IDs in data never change) ---
BUILDING_NAME=Demo Building
LEVEL_NAME=Level 4
# room_id:Display name, comma separated. An unlisted room shows the name written on the floor plan
# (dashboard/plan.json), and its ID only if it is not on the plan either.
ROOM_NAMES=room1:Lab 2,room2:Hall A,room3:Room 3

# --- Admin token for POST /api/emergency and /api/chat (sent as X-Admin-Token) ---
# Empty: local mode allows only the server machine itself; huawei mode refuses (must be set on ECS).
ADMIN_TOKEN=
# Named tokens, so the audit log shows which warden started or ended an emergency: label:token, comma separated
ADMIN_TOKENS=
# Tokens must be at least 16 characters. If every token set is shorter, emergency and chat are refused until fixed.
# Make each one random, one per person: python scripts/new_token.py --admin warden1 (adds it to ADMIN_TOKENS)
# Huawei mode refuses to start with example values, short secrets, or without VIEWER_TOKEN and an admin token.
# Per IP: chat questions and emergency presses per minute. 5 wrong tokens in 10 min refuse further guesses from that
# IP for 15 min; a right token always works, so nobody can lock a warden out.
CHAT_PER_MIN=10
EMERGENCY_PER_MIN=6

# --- Access ---
# Read access to the dashboard (sent as X-Viewer-Token). Empty = anyone who can reach the server can read it.
# Required in huawei mode. Make one with: python scripts/new_token.py --viewer
VIEWER_TOKEN=
# on = the server computer itself is admin without a token, only for requests with no proxy headers at all.
# Set off when others use that computer. Always off in huawei mode.
LOCALHOST_ADMIN=on
# Reverse proxy addresses, comma separated. X-Forwarded-For is trusted only from these. Empty = no proxy.
# Run uvicorn with --no-proxy-headers --limit-concurrency 200 --timeout-keep-alive 5 either way.
TRUSTED_PROXIES=
# Per-IP requests per minute (429 with Retry-After when over); kept in Valkey
READ_PER_MIN=240
HISTORY_PER_MIN=60
ADMIN_PER_MIN=30
STATIC_PER_MIN=600
# Seconds /api/rooms is cached (a hundred open dashboards cost one read)
ROOMS_CACHE_S=1

# --- Report checks ---
# A count that changes by more than this within one report is held back as suspicious until the next report agrees
JUMP_LIMIT=20
# Minimum seconds between reports from one board for one room; faster ones are dropped. Empty = REPORT_INTERVAL_S / 2
DEVICE_MIN_GAP_S=

# --- MQTT over TLS (optional, local mode): python scripts/mqtt_tls.py, then the boards use port 8883 ---
# on = the server also connects over TLS (port 8883 by default) with the CA below
MQTT_TLS=
MQTT_CA_FILE=deploy/mosquitto/certs/ca.crt
# 127.0.0.1 = plain 1883 for this computer only (set once every board uses TLS). Empty = same as MQTT_LAN_IP
MQTT_PLAIN_IP=

# --- History and logs ---
# MySQL history older than this is deleted once a day
HISTORY_RETENTION_DAYS=90
# Optional log file (rotated at LOG_MAX_MB, 5 old files kept), e.g. logs/nadi.log. Empty = console only
LOG_FILE=
LOG_MAX_MB=10

# --- Huawei IoTDA (device side, used by sim/fake_sensor.py in huawei mode) ---
# Console > IoTDA > Overview > Access Details > MQTTS host (port 8883)
IOTDA_HOST=xxxxxxxxxx.st1.iotda-device.ap-southeast-1.myhuaweicloud.com
IOTDA_PORT=8883
IOTDA_DEVICE_ID=
IOTDA_DEVICE_SECRET=
# Optional path to the IoTDA CA cert (.pem/.crt). Leave empty to use the system CA store.
IOTDA_CA_CERT=
# Optional app-side API endpoint for the read-only check deploy/huawei_preflight.py (Console > IoTDA > Overview >
# Access Details). Empty = the region's default endpoint.
IOTDA_API_ENDPOINT=

# Rooms the simulator fakes, comma separated
SIM_ROOMS=room1,room2,room3

# --- Server ---
# Shared token IoTDA must send as ?token=... on the forwarding URL. Required in huawei mode (the server refuses to
# start without it). Empty in local mode = only this computer may post to /iotda (sim/fake_sensor.py --local).
INGEST_TOKEN=
# Number to call, shown on the export for emergency services. Empty = "999 (112 from a mobile phone)" in the page's
# language. A value here is shown as it is, in both languages (40 characters at most).
EMERGENCY_NUMBER=
# Incident and drill reports and their minute snapshots (git-ignored). Relative to the project folder.
INCIDENT_DIR=data/incidents
# Clock check: the dashboard warns when the server clock is more than 60 s off this NTP server. off = no check.
NTP_SERVER=pool.ntp.org
NTP_CHECK=on
# Headcount threshold rule on motion_std: count = number of thresholds exceeded (0, 1, 2, 3+)
HEADCOUNT_THRESHOLDS=0.35,0.95,1.55

# --- Valkey / Redis (local Docker Valkey, or DCS for Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MySQL (local Docker or RDS) ---
MYSQL_HOST=127.0.0.1
# 3307 = local Docker (see docker-compose.yml). RDS uses 3306.
MYSQL_PORT=3307
MYSQL_USER=nadi
MYSQL_PASSWORD=nadi_local_pw
MYSQL_DATABASE=nadi

# --- Huawei Cloud API (IAM user nadi-dev, programmatic access only) ---
# From credentials.csv. Used by KooCLI / huaweicloud-devkit / SDK. Never commit.
HUAWEICLOUD_AK=
HUAWEICLOUD_SK=
HUAWEICLOUD_REGION=ap-southeast-1

# --- ECS ---
ECS_PUBLIC_IP=

# --- Send rate ---
# One combined report for all rooms every N seconds, same as the receiver's "Seconds per report". Never below 10.
# Local mode: 10. Huawei mode: use 20 (IoTDA free tier: 10,000 msgs/day for all devices; 10 s plus a climate node is about 10,080).
REPORT_INTERVAL_S=10

# --- Air conditioning waste ---
# These are first-start defaults. Once an admin saves the Energy settings on the Energy page, the saved values
# apply and these lines are no longer read (CO2_KG_PER_KWH below too). Delete all data brings the defaults back.
# Minutes a room must be empty with the air conditioning on before it is flagged.
WASTE_MINUTES=10
# Air conditioner power (kW) and TNB tariff used for the RM wasted figure
AC_KW=10
TARIFF_RM_PER_KWH=0.2983

# --- Alerts: Huawei SMN, huawei mode only (empty = console + dashboard only). Also needs HUAWEICLOUD_AK/SK above. ---
SMN_TOPIC_URN=
# Optional, defaults to HUAWEICLOUD_REGION
SMN_REGION=

# --- Occupancy model (from ml/train.py). Missing file = threshold rule above ---
MODEL_PATH=ml/model/nadi_model.json

# --- Chat, local mode: Ollama (OpenAI-compatible). Not running = built-in plain-text answers. Empty model = off ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Seconds to wait for the chat model (Ollama or MaaS) before showing the checked built-in answer instead
CHAT_TIMEOUT_S=5

# --- Chat, huawei mode: Huawei ModelArts Studio (MaaS), OpenAI-compatible (empty = built-in plain-text answers) ---
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=

# --- Stage day: on = play the fixed 3-minute demo story through Mosquitto (local mode only); the dashboard shows
# DEMO SCENARIO while it runs. Off for real use. Do not run sim/fake_sensor.py at the same time.
DEMO_SCENARIO=
# on = in the demo story, Hall A is an exact people counter passing 100 (a phase 2 idea, labelled "Simulated counter
# (phase 2)" on every screen). Empty = every room on Wi-Fi sensing (0, 1, 2 or 3+), what one sensor pair can tell.
DEMO_BIG_HALL=
# Where the /label page saves headcount labels (default ml/data/labels.csv, git-ignored)
LABELS_PATH=

# --- Buildings, floors and floor plans (Floor plan page). Stored as files, not in MySQL, so the emergency view can
# draw a plan while the database is down. Empty folder = the built-in Demo Building, Level 4 (dashboard/plan.json).
SITE_DIR=data/site
# on: admins can edit plans in the console. off: the editor is hidden and its write endpoints answer 404.
PLAN_EDITOR=on
# on: a read-only "Example Tower (example data)" with 12 floors and no sensors appears in the building switcher.
EXAMPLE_BUILDING=on
# on: Ask NADI answers for the floor chosen in the switcher (or the whole building) and says which. off: whole building, as before.
CHAT_SCOPE=on

# --- Energy page: grid emission factor used for the CO2 estimate (kg CO2 per kWh). An estimate: replace it with the
# official figure for the grid you are on before quoting the CO2 number. A first-start default, like the waste values.
CO2_KG_PER_KWH=0.75
